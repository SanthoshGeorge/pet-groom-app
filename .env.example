# Environment variables — Pet Grooming Booking Platform
#
# Copy this file to `.env` (local development) and fill in real values. Every variable
# below comes straight from `aidlc-docs/construction/pet-grooming-booking-platform/
# infrastructure-design/deployment-architecture.md`'s "Environment Variables" table — there
# are no others. In production (Vercel), these are set in the project's Vercel Environment
# Variables settings instead of a committed .env file (see README.md's Deployment section).
#
# No real secrets belong in this file, in `.env`, or in git — `.env` is already listed in
# .gitignore.

# ---------------------------------------------------------------------------------------
# DATABASE_URL — Neon Postgres pooled connection string.
# Get it from: your Neon project dashboard -> Connection Details -> "Pooled connection"
# (the app's Prisma driver-adapter setup expects the pooled endpoint, not the direct one).
# For local development, point this at any local/dev Postgres instance instead.
# ---------------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/petgroom?sslmode=require"

# ---------------------------------------------------------------------------------------
# SESSION_SECRET — signs/encrypts the httpOnly session cookie (BR-AUTH-4).
# Not a value you "get" from anywhere — generate a long, random string yourself, e.g.:
#   openssl rand -base64 32
# Use a different value per environment; never reuse the example below.
# ---------------------------------------------------------------------------------------
SESSION_SECRET="replace-with-a-long-random-string-generated-locally"

# ---------------------------------------------------------------------------------------
# RESEND_API_KEY — transactional email (booking confirmations, cancellations, password
# reset) via Resend.
# Get it from: your Resend dashboard -> API Keys -> Create API Key.
# ---------------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"

# ---------------------------------------------------------------------------------------
# CRON_SECRET — shared secret the daily reminder job's route (POST /api/cron/reminders)
# checks via `Authorization: Bearer <CRON_SECRET>`.
# Not a value you "get" from anywhere — generate a long, random string yourself, e.g.:
#   openssl rand -base64 32
# When this is set in Vercel's Environment Variables, Vercel Cron automatically sends it
# as that exact header on every invocation defined in vercel.json — no extra Vercel
# configuration needed beyond setting the variable.
# ---------------------------------------------------------------------------------------
CRON_SECRET="replace-with-a-long-random-string-generated-locally"

# ---------------------------------------------------------------------------------------
# SMS provider credentials are intentionally absent. The current SMS "send" is a log-only
# stub (NFR Requirements Q6=B, tech-stack-decisions.md) that needs no credentials. Adding
# real SMS later (e.g. Twilio) means adding a TWILIO_* set of variables here, not changing
# anything above.
# ---------------------------------------------------------------------------------------
